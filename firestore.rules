rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Custom Firestore Auth (no Firebase Auth) – allow all for demo, but keep user isolation via uid check if auth exists
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    match /users/{userId}/watchlist/{docId} {
      allow read, write: if true;
    }
    match /userStats/{userId} {
      allow read: if true;
      allow write: if true;
    }
    match /comments/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }
    match /forumThreads/{docId} {
      allow read: if true;
      allow create, update: if true;
    }
    match /forumThreads/{threadId}/replies/{replyId} {
      allow read: if true;
      allow create, update: if true;
    }
    match /shoutbox/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /reviews/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
    match /requests/{docId} {
      allow read: if true;
      allow create: if true;
    }
    match /notifications/{docId} {
      allow read, write: if true;
    }
    match /customLists/{docId} {
      allow read: if true;
      allow create, update, delete: if true;
    }
  }
}
